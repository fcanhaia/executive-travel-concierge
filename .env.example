APP_ENV=local
LOG_LEVEL=INFO
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_API_KEY_SECRET_ID=concierge-gemini-api-key
TRAVEL_PROVIDER_API_KEY_SECRET_ID=concierge-travel-provider-api-key
GEMINI_API_KEY=replace-with-local-dev-key-only-in-dotenv
TRAVEL_PROVIDER_API_KEY=sandbox-provider-token
SESSION_DB_URL=sqlite+aiosqlite:///./concierge_sessions.db
OTEL_SERVICE_NAME=executive-travel-concierge
ENABLE_CLOUD_TRACE=false